# Makefile for the interface between the FEM code and the multi-level
#   block iterative solver (using only single level capabilities and GMRES)

$(MOD_FEM_OBJ_DIR)/sil_krb_lib.a: \
  	  $(MOD_FEM_OBJ_DIR)/sis_krylow_bliter_intf.o \
	  $(MOD_FEM_OBJ_DIR)/sis_krylow_bliter_fem_intf.o \
	  $(MOD_FEM_INC_DIR)/sih_intf.h sih_krylow_bliter.h
	$(AR) $@ $(MOD_FEM_OBJ_DIR)/sis_krylow_bliter_intf.o \
          $(MOD_FEM_OBJ_DIR)/sis_krylow_bliter_fem_intf.o	

$(MOD_FEM_OBJ_DIR)/sis_krylow_bliter_intf.o: sis_krylow_bliter_intf.c \
	  $(MOD_FEM_INC_DIR)/sih_intf.h sih_krylow_bliter.h
	$(CC) $(CFL) -c sis_krylow_bliter_intf.c -o $@ $(INC)


$(MOD_FEM_OBJ_DIR)/sis_krylow_bliter_fem_intf.o: sis_krylow_bliter_fem_intf.c \
	  sih_krylow_bliter.h
	$(CC) $(CFL) -c sis_krylow_bliter_fem_intf.c -o $@ $(INC)

clean:
	rm -f *~ *.o *.a

