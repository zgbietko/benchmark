pressure_pins:
(
  {
    node_coor = [0.0, 0.0, 0.0];
    p = 0.0;
  },
  {
    node_coor = [0.0, 0.0, 0.01];
    p = 0.0;
  }
);

velocity_pins:
(
  {
    node_coor = [0.0, 1.0, 0.0];
    v = [0.0, 0.0, 0.0];
  },
  {
    node_coor = [0.0, 1.0, 0.01];
    v = [0.0, 0.0, 0.0];
  },
  {
    node_coor = [1.0, 1.0, 0.0];
    v = [0.0, 0.0, 0.0];
  },
  {
    node_coor = [1.0, 1.0, 0.01];
    v = [0.0, 0.0, 0.0];
  }
);



