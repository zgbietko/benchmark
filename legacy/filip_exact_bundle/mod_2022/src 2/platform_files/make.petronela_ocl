# C compiler
#CC = gcc
CC = icc

# C++ compiler
#CPPC = g++
CPPC = icpc

# Loader (to link with Fortran libraries)
#LD = g++
LD = icpc

# Archiver
AR = ar r

# For removing files
RM = rm -f

# Include directory for MOD_FEM code
INC_DIR = $(MOD_FEM_DIR)/src/include

# Include directories
INC = -I$(MOD_FEM_DIR)/src/include -I/opt/intel/composerxe/mkl/include -I/opt/intel/opencl/include

# Standard and/or local libraries
LIB = -L$(MOD_FEM_OBJ_DIR) -L$(MKLROOT)/lib/intel64 -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -fopenmp -lpthread -lconfig -openmp -L/opt/intel/opencl/lib64/ -lOpenCL -lm 

# sequential MKL version
#LIB = -L$(MOD_FEM_OBJ_DIR) -L$(MKLROOT)/lib/intel64 -lmkl_intel_lp64 -lmkl_sequential -lmkl_core -lpthread -lconfig -L/opt/AMDAPP/lib/x86_64/ -lOpenCL -lm


# C optimization and other flags
CFL =  -DDEBUG -DDEBUG_MMM -DDEBUG_APM -DDEBUG_SIM -DDEBUG_LSM -g -Wconversion -openmp -DMULTITHREADED -DOPENCL_PHI -DTUNING
#CFL = -O3 -lstdc++ -openmp

# Loader optimization and other flags
LDFL = -g -openmp -DMULTITHREADED -DOPENCL_PHI -DTUNING
#LDFL = -O3 -openmp


