# C compiler
CC = mpicc

# C++ compiler
CPPC = mpic++

# Loader (to link with Fortran libraries)
LD = mpicc

# Archiver
AR = ar r

# For removing files
RM = rm -f

# Include directory for MOD_FEM code
INC_DIR = $(MOD_FEM_DIR)/src/include

# Include directories
INC = -I$(MOD_FEM_DIR)/src/include

# Standard and/or local libraries
#LIB = -L$(MOD_FEM_OBJ_DIR) -L$(MKLROOT)/lib/intel64 -lmkl_intel_lp64 \
  -lmkl_intel_thread -lmkl_core -openmp -lpthread -L$(MOD_FEM_DIR)/lib \
  /usr/local/lib64/libconfig.a

# sequential MKL version
LIB = -L$(MOD_FEM_OBJ_DIR) -L$(MKLROOT)/lib/intel64 -lmkl_intel_lp64 \
  -lmkl_sequential -lmkl_core -lpthread -lconfig


# C optimization and other flags
CFL =  -DDEBUG -DDEBUG_MMM -DDEBUG_APM -DDEBUG_SIM -DDEBUG_LSM -g -DPARALLEL
#CFL = -O3 -funroll-loops -ffast-math -DWITH_ -m64 -DPARALLEL 

# Loader optimization and other flags
LDFL = -g
#LDFL = -O3 -funroll-loops -ffast-math -m64

