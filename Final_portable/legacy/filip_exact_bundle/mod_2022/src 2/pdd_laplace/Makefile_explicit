# Makefile for problem dependent module that test sequential modules
# by solving simple Laplace equation

$(MOD_FEM_OBJ_DIR)/pdl_laplace_std_lib.a : \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_main.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_pde.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_std_ls_intf.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_std_adapt.o
	$(AR) $@ $(MOD_FEM_OBJ_DIR)/pds_laplace_main.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_pde.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_std_ls_intf.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_std_adapt.o

$(MOD_FEM_OBJ_DIR)/pdl_laplace_dg_lib.a : \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_main.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_pde.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_dg_ls_intf.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_dg_adapt.o
	$(AR) $@ $(MOD_FEM_OBJ_DIR)/pds_laplace_main.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_pde.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_dg_ls_intf.o \
           $(MOD_FEM_OBJ_DIR)/pds_laplace_dg_adapt.o

# problem dependent obj files for testing modules
$(MOD_FEM_OBJ_DIR)/pds_laplace_main.o : pds_laplace_main.c \
	$(MOD_FEM_INC_DIR)/uth_intf.h \
	$(MOD_FEM_INC_DIR)/mmh_intf.h \
	$(MOD_FEM_INC_DIR)/aph_intf.h \
	$(MOD_FEM_INC_DIR)/sih_intf.h
#	makedepend $(INC) pds_laplace_std_main.c
	$(CC) $(CFL) -c pds_laplace_main.c -o $@ $(INC) 

$(MOD_FEM_OBJ_DIR)/pds_laplace_pde.o : pds_laplace_pde.c \
	$(MOD_FEM_INC_DIR)/pdh_intf.h pdh_laplace.h 
	$(CC) $(CFL) -c pds_laplace_pde.c -o $@ $(INC) 

$(MOD_FEM_OBJ_DIR)/pds_laplace_std_ls_intf.o : \
          approx_std/pds_laplace_std_ls_intf.c \
	  $(MOD_FEM_INC_DIR)/pdh_intf.h pdh_laplace.h
	$(CC) $(CFL) -c approx_std/pds_laplace_std_ls_intf.c -o $@ $(INC)

$(MOD_FEM_OBJ_DIR)/pds_laplace_std_adapt.o : \
          approx_std/pds_laplace_std_adapt.c \
	  $(MOD_FEM_INC_DIR)/pdh_intf.h pdh_laplace.h
	$(CC) $(CFL) -c approx_std/pds_laplace_std_adapt.c -o $@ $(INC) 

$(MOD_FEM_OBJ_DIR)/pds_laplace_dg_ls_intf.o : \
          approx_dg/pds_laplace_dg_ls_intf.c \
	  $(MOD_FEM_INC_DIR)/pdh_intf.h pdh_laplace.h
	$(CC) $(CFL) -c approx_dg/pds_laplace_dg_ls_intf.c -o $@ $(INC) 

$(MOD_FEM_OBJ_DIR)/pds_laplace_dg_adapt.o : \
          approx_dg/pds_laplace_dg_adapt.c \
	  $(MOD_FEM_INC_DIR)/pdh_intf.h pdh_laplace.h
	$(CC) $(CFL) -c approx_dg/pds_laplace_dg_adapt.c -o $@ $(INC)

clean:
	rm -f *~ *.o *.a approx_*/*.o approx_*/*.a