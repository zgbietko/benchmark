# for LINUX:
# add libraries: -llapack -lblas 
# or ../lib/lapack_linux.a ../lib/blas_linux.a 

# C compiler
#CC = icc 
CC = gcc

# C++ compiler
#CPPC = icpc
CPPC = g++

# Loader (to link with Fortran libraries)
#LD = icc
LD = gcc

# C++ Loader (to link with pardiso solver)
#LDPP = icpc 
LDPP = g++

# Archiver
AR = ar r

# For removing files
RM = rm -f

# Include directory for MOD_FEM code
INC_DIR = $(MOD_FEM_DIR)/src/include

# Include directories
INC = -I$(MOD_FEM_DIR)/src/include -I/opt/intel/mkl/include -I/usr/local/cuda/include

# Standard and/or local libraries
LIB = -L$(MOD_FEM_OBJ_DIR) -L/opt/intel/mkl/lib/intel64 -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -lpthread -lm -lOpenCL

# C optimization and other flags
#CFL =  -DDEBUG -DDEBUG_MMM -DDEBUG_APM -DDEBUG_SIM -DDEBUG_LSM -g -Wconversion
CFL = -O3 -openmp -DMULTITHREADED -DOPENCL_GPU
# -DTUNING

# Loader optimization and other flags
#LDFL = -g
LDFL = -O3 -openmp -DMULTITHREADED -DOPENCL_GPU
# -DTUNING

