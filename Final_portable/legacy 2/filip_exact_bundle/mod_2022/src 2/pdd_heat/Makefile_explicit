# Makefile for heat convection-diffusion with SUPG stabilization

$(MOD_FEM_OBJ_DIR)/pdl_heat_lib.a : \
           $(MOD_FEM_OBJ_DIR)/pds_heat_main.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_time_integration.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_ls_intf.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_adapt.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_paraview_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_weakform.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_materials.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_bc.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_problem_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_materials_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_bc_io.o 
	$(AR) $@ $(MOD_FEM_OBJ_DIR)/pds_heat_main.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_time_integration.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_ls_intf.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_adapt.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_paraview_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_weakform.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_materials.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_bc.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_problem_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_materials_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_heat_bc_io.o 

# Makefile for problem dependent module for convection-diffusion eqns and STD
# with OpenCL support 
$(MOD_FEM_OBJ_DIR)/pdl_heat_std_opencl_lib.a : \
           $(MOD_FEM_OBJ_DIR)/pds_heat_ls_intf_std_opencl.o
	$(AR) $@ $(MOD_FEM_OBJ_DIR)/pds_heat_ls_intf_std_opencl.o 


$(MOD_FEM_OBJ_DIR)/pds_heat_main.o : main/pds_heat_main.c 
	$(CC) $(CFL) -c main/pds_heat_main.c -o $@ $(INC)

$(MOD_FEM_OBJ_DIR)/pds_heat_time_integration.o : \
	time_integration/pds_heat_time_integration.c 
	$(CC) $(CFL) -c time_integration/pds_heat_time_integration.c -o $@ $(INC)

