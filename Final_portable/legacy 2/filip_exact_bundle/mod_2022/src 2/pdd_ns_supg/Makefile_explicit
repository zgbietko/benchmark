           $(MOD_FEM_OBJ_DIR)/pds_ns_supg_weakform.o \
           $(MOD_FEM_OBJ_DIR)/pds_ns_supg_materials.o \
           $(MOD_FEM_OBJ_DIR)/pds_ns_supg_bc.o \
           $(MOD_FEM_OBJ_DIR)/pds_ns_supg_problem_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_ns_supg_materials_io.o \
           $(MOD_FEM_OBJ_DIR)/pds_ns_supg_bc_io.o 

